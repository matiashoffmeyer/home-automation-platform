{#- NUC-helbred (B272, packages/nuc_helbred.yaml). Håndskrevet.
    Brug: {% from 'nuc.jinja' import nuc_grunde %}

    nuc_grunde(): hvorfor er binary_sensor.nuc_helbred_alarm tændt? Én kilde til
    både dens state og attributten `grunde`; tom streng = sund. Teksten skifter
    KUN når et problem kommer til eller en SMART-tæller vokser — push-automationen
    trigger på netop den attribut, så en tal-værdi der svinger (temperatur,
    slid-%, kernel-tælleren der ruller ud af ringbufferen) står IKKE i teksten. -#}
{% macro nuc_grunde() -%}
{%- set s = 'sensor.nuc_smart' -%}
{%- set g = namespace(l=[]) -%}
{%- if states(s) not in ['PASSED', 'FAILED']
      or now().timestamp() - as_timestamp(state_attr(s, 'ts'), 0) > 26 * 3600 -%}
  {%- set g.l = g.l + ['SMART ikke læst i over 26 t'] -%}
{%- endif -%}
{%- if is_state(s, 'FAILED') or state_attr(s, 'failing_attrs') | default([], true) | count > 0 -%}
  {%- set g.l = g.l + ['disken melder selv svigt (SMART)'] -%}
{%- endif -%}
{#- Livstids-tællere: baseline 28/10 = 0 for dem alle (170-fabriksblokkene, 587,
    tæller ikke — de var markeret fra fabrikken). -#}
{%- for key, tekst in [('bad_blocks_later', 'nye dårlige blokke'),
                       ('retired_blocks', 'pensionerede blokke'),
                       ('pending', 'ventende sektorer'),
                       ('uncorrectable', 'urettelige læsefejl'),
                       ('crc_errors', 'CRC-fejl på SATA-linket'),
                       ('error_log', 'fejl i diskens fejllog')] -%}
  {%- set n = state_attr(s, key) | int(0) -%}
  {%- if n > 0 %}{% set g.l = g.l + [n ~ ' ' ~ tekst] %}{% endif -%}
{%- endfor -%}
{%- if states('sensor.nuc_kernel_fejl') | int(0) > 0 -%}
  {%- set g.l = g.l + ['disk-/hardwarefejl i kernel-loggen'] -%}
{%- endif -%}
{%- if states('sensor.nuc_ssd_slid') | float(0) >= 80 -%}
  {%- set g.l = g.l + ['SSD over 80 % slidt'] -%}
{%- endif -%}
{%- if states('sensor.nuc_cpu_temperatur') | float(0)
      >= states('input_number.nuc_cpu_temp_graense') | float(90) -%}
  {%- set g.l = g.l + ['CPU over temperatur-grænsen'] -%}
{%- endif -%}
{{ g.l | join(' · ') }}
{%- endmacro %}
