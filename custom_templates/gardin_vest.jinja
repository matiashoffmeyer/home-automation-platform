{#- =========================================================================
    Stue vest (Somfy RTS via Broadlink — ENVEJS): hvor står gardinet NU?
    2026-11-23 (user: "jeg trykkede ned for at få den ned i den højde der er
    god til projektor … den gik alt for langt ned"): vinter-lukningen havde
    sat vest på 20 % kl. 16:20; RODRET'ens 2. ned-klik 19:46 kørte alligevel
    de fulde 13 s NED → i bund, og efter et stop var positionen glemt, så
    næste luk også ramte bunden.

    Hver kørsel bogføres i input_text.gardin_vest_koersel som
    {"t0": epoch, "fra": %, "til": %, "sek": s} (script.gardin_vest_koersel_saet;
    hvile = sek 0, ukendt = -1). Så kan et stop midt i en kørsel regne
    positionen ud, og et luk kører kun resten ned til 85 %-linjen.

    pos_nu()  → position i % (100 = oppe) lige nu, -1 = ukendt.
    i_gang()  → 'ja' mens en bogført kørsel stadig er undervejs, ellers ''.
    Én definition (#2): vest-coveret, script.gardin_vest_position,
    script.gardin_vest_stop og RODRET'ens køretider (packages/broadlink_gardiner.yaml).
========================================================================= -#}

{%- macro _k() -%}
{%- set raw = states('input_text.gardin_vest_koersel') -%}
{{- raw if raw.startswith('{') else '{}' -}}
{%- endmacro -%}

{%- macro pos_nu() -%}
{%- set k = _k() | from_json -%}
{%- if 't0' in k -%}
  {%- set el = as_timestamp(now()) - (k.t0 | float(0)) -%}
  {%- set sek = k.sek | float(0) -%}
  {%- set fra = k.fra | float(-1) -%}
  {%- set til = k.til | float(-1) -%}
  {%- if el >= sek -%}{{ til | round(0) | int }}
  {%- elif fra >= 0 and til >= 0 -%}{{ ([[fra + (til - fra) * el / sek, 0] | max, 100] | min) | round(0) | int }}
  {%- else -%}-1{%- endif -%}
{%- else -%}
  {#- Ingen bogført kørsel endnu (første gang efter deploy): den gamle reference. -#}
  {%- set ref = states('input_number.gardin_vest_antaget_pos') | float(-1) -%}
  {%- set ok = (state_attr('input_datetime.gardin_vest_antaget_at', 'timestamp') | float(0)) > 0 -%}
  {{- (ref | round(0) | int) if ok and ref >= 0 else -1 -}}
{%- endif -%}
{%- endmacro -%}

{%- macro i_gang() -%}
{%- set k = _k() | from_json -%}
{{- 'ja' if 't0' in k and (as_timestamp(now()) - (k.t0 | float(0))) < (k.sek | float(0)) else '' -}}
{%- endmacro -%}
