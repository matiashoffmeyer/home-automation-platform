{#- Robotstøvsugerens pris pr. handling, inkl. el og vand
    (packages/roborock_handlingspris.yaml — modellen og målingerne står i
    dens header). Håndskrevet.
    Brug: {% from 'roborock_pris.jinja' import pris, pris_tekst %}

    pris(m2, gennemloeb, vaske, toerring): kr som tal (2 decimaler).
      m2          areal i m²
      gennemloeb  1 = hurtig/normal, 2 = grundig
      vaske       antal mopvaske i dokken (0 når den ikke moper)
      toerring    1 når dokken tørrer moppen bagefter, ellers 0
    pris_tekst(...): samme, som "(23 øre)" under 1 kr (mindst 1 øre),
      ellers "(1,25 kr)" — til knapperne (user-spec 2026-11-15). -#}
{%- macro pris(m2, gennemloeb, vaske, toerring) -%}
{%- set el = states('sensor.elpris_allin_aktuel') | float(2.5) -%}
{%- set vand = (states('input_number.roborock_vandpris_kr_m3') | float(54.93)) / 1000 -%}
{%- set toer = states('input_number.roborock_toerring_kwh') | float(0.06) -%}
{%- set kwh = (m2 * gennemloeb * 0.9 + 4 + vaske * 10) / 1000 + toerring * toer -%}
{{- (kwh * el + vaske * 0.18 * vand) | round(2) -}}
{%- endmacro -%}
{%- macro pris_tekst(m2, gennemloeb, vaske, toerring) -%}
{%- set kr = pris(m2, gennemloeb, vaske, toerring) | float(0) -%}
{%- if kr < 1 -%}({{ [(kr * 100) | round(0) | int, 1] | max }} øre)
{%- else -%}({{ ('%.2f' | format(kr)) | replace('.', ',') }} kr){%- endif -%}
{%- endmacro -%}
