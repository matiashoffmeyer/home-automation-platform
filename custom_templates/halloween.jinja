{#- Halloween-stemningens lån (packages/halloween_stemning.yaml). Håndskrevet.
    Brug: {% from 'halloween.jinja' import laant %}{{ laant(entity) | trim == 'true' }}

    laant(entity): 'true' mens stemningen har pæren i et dyk. Stemplet
    input_text.halloween_stemning_laan er "<slut-unix>|lys[:b0],lys[:b0]…|<rum>"
    (rum = room_mode-suffikset). b0 står der kun mens dykket kører
    (halloween_stemning_ret læser det), og slut har 5 s margin til pærens
    sidste rapport. Til automatikker der reagerer på et NIVEAU-skift
    (power-recovery, stue-spejlet): de skal lade stemningens dyk og
    gendannelse være. -#}
{% macro laant(entity) -%}
{%- set g = (states('input_text.halloween_stemning_laan') ~ '').split('|') -%}
{%- set lys = (g[1] if g | count >= 2 else '').split(',') | map('regex_replace', ':.*$', '') | list -%}
{{- 'true' if entity in lys and now().timestamp() < (g[0] | float(0)) else 'false' -}}
{%- endmacro %}

{#- glimt(slags, n, tempo): trinene for ét glimt af slags `slags` på n pærer,
    som JSON: {"paerer": [{"trin": [[andel, ms] | [andel, ms, 'g', hue] |
    [andel, ms, 'n']], "forsink": ms}, … n], "ms": varighed, "nominel": ms}.
    Bruges af script.halloween_stemning_glimt: {{ glimt('k', 1, 2) | from_json }}.

    Små (ÉN pære): k knitren (løs forbindelse i 1-3 klynger) · h ét hak ·
    d dobbelthak · s summen (hurtig, lav flimren) · x døende pære (dykker
    dybere og dybere) · v spændingsfald (synker, hænger, smutter op) ·
    g grønt blink · G grønt flimmer (dagens eneste slags: 2-4 hurtige grønne
    pulser i samme nuance).
    Store (hele rummet): F rum-flimmer · U udfald · K kaskade (pærerne efter
    hinanden — kræver ≥ 2) · B brownout · P hjerteslag · L langt udfald
    (pærerne kommer tilbage hver for sig) · W bølge.

    Et trin er internt [andel, ms, hold]: hold = 0 er et BLINK, hvis ms deles
    med tempo (1 = 24/10's tempo, 2 = dobbelt så hurtigt); hold = 1 er en
    pause/mørke der står som den er. "nominel" = varigheden ved tempo 1, så
    løkken kan holde samme antal glimt i timen uanset tempoet. Gulv 20 ms pr.
    blink: ZHA-kaldet selv tager ~60-90 ms (målt 24/10: trin ved 60 ms
    planlagt lå 0,11-0,15 s fra hinanden). -#}
{% macro glimt(slags, n, tempo) -%}
{%- set T = [0.5, [4, tempo | float(1)] | min] | max -%}
{%- set n = [1, n | int(1)] | max -%}
{%- set b = namespace(t=[]) -%}
{%- if slags == 'k' -%}
  {%- for c in range(range(1, 4) | random) -%}
    {%- if c > 0 -%}{%- set b.t = b.t + [[1, range(300, 1201) | random, 1]] -%}{%- endif -%}
    {%- for i in range(range(2, 5) | random) -%}
      {%- set b.t = b.t + [[(range(3, 46) | random) / 100, range(40, 201) | random, 0],
                           [(range(80, 101) | random) / 100, range(40, 251) | random, 0]] -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- if (range(100) | random) < 35 -%}
    {%- set b.t = b.t + [[(range(2, 15) | random) / 100, range(350, 901) | random, 1]] -%}
  {%- endif -%}
{%- elif slags == 'h' -%}
  {%- set b.t = [[(range(2, 26) | random) / 100, range(60, 181) | random, 0]] -%}
  {%- if (range(100) | random) < 30 -%}
    {%- set b.t = b.t + [[0.9, range(60, 121) | random, 0], [0.6, range(40, 81) | random, 0]] -%}
  {%- endif -%}
{%- elif slags == 'd' -%}
  {%- set b.t = [[(range(5, 31) | random) / 100, range(50, 131) | random, 0], [1, range(80, 161) | random, 0],
                 [(range(5, 31) | random) / 100, range(50, 131) | random, 0], [1, range(500, 1401) | random, 1],
                 [(range(2, 21) | random) / 100, range(60, 161) | random, 0]] -%}
{%- elif slags == 's' -%}
  {%- for i in range(range(4, 9) | random) -%}
    {%- set b.t = b.t + [[(range(55, 81) | random) / 100, range(25, 71) | random, 0],
                         [(range(85, 101) | random) / 100, range(25, 71) | random, 0]] -%}
  {%- endfor -%}
{%- elif slags == 'x' -%}
  {%- set k = range(4, 7) | random -%}
  {%- for i in range(k) -%}
    {%- set dyb = [0.03, 0.7 - i * 0.65 / (k - 1) + (range(-5, 6) | random) / 100] | max -%}
    {%- set b.t = b.t + [[dyb | round(2), range(60, 161) | random, 0], [1, [60, 250 - i * 40] | max, 0]] -%}
  {%- endfor -%}
  {%- set b.t = b.t + [[(range(3, 9) | random) / 100, range(600, 1501) | random, 1],
                       [0.5, range(60, 101) | random, 0], [0.1, range(60, 121) | random, 0]] -%}
{%- elif slags == 'v' -%}
  {%- for a in [0.85, 0.65, 0.45] -%}
    {%- set b.t = b.t + [[a + (range(-5, 6) | random) / 100, range(80, 141) | random, 0]] -%}
  {%- endfor -%}
  {%- set b.t = b.t + [[(range(35, 56) | random) / 100, range(800, 2001) | random, 1],
                       [1, range(60, 101) | random, 0], [0.6, range(50, 91) | random, 0]] -%}
{%- elif slags == 'g' -%}
  {%- for i in range(range(1, 3) | random) -%}
    {%- set b.t = b.t + [[(range(55, 101) | random) / 100, range(120, 281) | random, 0, 'g', range(105, 136) | random],
                         [1, range(250, 901) | random, 0, 'n']] -%}
  {%- endfor -%}
{%- elif slags == 'G' -%}
  {%- set hue = range(105, 136) | random -%}
  {%- for i in range(range(2, 5) | random) -%}
    {%- set b.t = b.t + [[(range(55, 101) | random) / 100, range(60, 151) | random, 0, 'g', hue],
                         [1, range(60, 181) | random, 0, 'n']] -%}
  {%- endfor -%}
{%- elif slags == 'F' -%}
  {%- for i in range(range(2, 5) | random) -%}
    {%- set b.t = b.t + [[(range(15, 51) | random) / 100, range(100, 301) | random, 0],
                         [(range(85, 101) | random) / 100, range(150, 501) | random, 0]] -%}
  {%- endfor -%}
{%- elif slags == 'U' -%}
  {%- set b.t = [[0.3, range(60, 121) | random, 0], [0.9, range(60, 101) | random, 0], [0, range(1500, 4001) | random, 1]] -%}
  {%- for i in range(range(2, 6) | random) -%}
    {%- set b.t = b.t + [[(range(20, 81) | random) / 100, range(60, 201) | random, 0],
                         [(range(0, 11) | random) / 100, range(60, 201) | random, 0]] -%}
  {%- endfor -%}
{%- elif slags == 'B' -%}
  {%- set b.t = [[0.8, range(100, 161) | random, 0], [0.6, range(100, 161) | random, 0], [0.4, range(100, 161) | random, 0],
                 [(range(25, 46) | random) / 100, range(1200, 3001) | random, 1],
                 [0.9, range(60, 101) | random, 0], [0.4, range(60, 121) | random, 0]] -%}
{%- elif slags == 'P' -%}
  {%- for i in range(range(2, 5) | random) -%}
    {%- if i > 0 -%}{%- set b.t = b.t + [[1, range(500, 901) | random, 1]] -%}{%- endif -%}
    {%- set b.t = b.t + [[(range(20, 46) | random) / 100, range(70, 121) | random, 0], [1, range(100, 151) | random, 0],
                         [(range(20, 46) | random) / 100, range(70, 121) | random, 0]] -%}
  {%- endfor -%}
{%- elif slags == 'L' -%}
  {%- set b.t = [[0.5, range(60, 101) | random, 0], [0.05, range(60, 101) | random, 0],
                 [0.7, range(80, 121) | random, 0], [0, range(4000, 7001) | random, 1]] -%}
{%- elif slags == 'W' -%}
  {%- for a in [0.8, 0.55, 0.3, 0.15, 0.3, 0.55, 0.8] -%}
    {%- set b.t = b.t + [[a, range(120, 201) | random, 0]] -%}
  {%- endfor -%}
  {%- set b.t = b.t + [[0.4, range(60, 101) | random, 0]] -%}
{%- endif -%}
{#- Pr. pære: K får sit eget dyk og en forsinkelse (retning tilfældig), L sit
    eget mørke-hold + hak tilbage; resten deler trinene (samme ur). -#}
{%- set kgap = range(150, 451) | random -%}
{%- set baglaens = (range(2) | random) == 1 -%}
{%- set ud = namespace(p=[], ms=0, nom=0) -%}
{%- for i in range(n) -%}
  {%- set p = namespace(t=b.t, fs=0) -%}
  {%- if slags == 'K' -%}
    {%- set p.fs = ((n - 1 - i) if baglaens else i) * kgap -%}
    {%- set p.t = [[(range(2, 21) | random) / 100, range(120, 301) | random, 0],
                   [0.7, range(50, 91) | random, 0], [0.2, range(50, 91) | random, 0]] -%}
  {%- elif slags == 'L' -%}
    {%- set p.t = b.t + [[0, range(0, 1501) | random, 1]] -%}
    {%- for j in range(range(1, 4) | random) -%}
      {%- set p.t = p.t + [[(range(30, 91) | random) / 100, range(60, 161) | random, 0],
                           [(range(0, 11) | random) / 100, range(60, 161) | random, 0]] -%}
    {%- endfor -%}
  {%- endif -%}
  {%- set r = namespace(t=[], ms=0, nom=0) -%}
  {%- for x in p.t -%}
    {%- set ms = x[1] if x[2] == 1 else [20, (x[1] / T) | round(0) | int] | max -%}
    {%- set r.ms = r.ms + ms -%}
    {%- set r.nom = r.nom + x[1] -%}
    {%- set r.t = r.t + [[x[0], ms] + x[3:]] -%}
  {%- endfor -%}
  {%- set fs = (p.fs / T) | round(0) | int -%}
  {%- set ud.p = ud.p + [{'trin': r.t, 'forsink': fs}] -%}
  {%- set ud.ms = [ud.ms, fs + r.ms] | max -%}
  {%- set ud.nom = [ud.nom, p.fs + r.nom] | max -%}
{%- endfor -%}
{{- {'paerer': ud.p, 'ms': ud.ms, 'nominel': ud.nom} | to_json -}}
{%- endmacro %}
