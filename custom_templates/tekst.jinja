{#- Tekst til mennesker (notifikationer). Håndskrevet — IKKE genereret som
    rosters.jinja. Brug: {% from 'tekst.jinja' import dansk %}

    dansk(navn): device-navne er ASCII-foldede i registret ("Hoveddoer
    Parasoll", "Entre Myggspray", "Badevaerelse Inde") → æøå til visning.
    Kun visning: entity_ids og registret er uændrede. -#}
{% macro dansk(navn) -%}
{{ (navn ~ '')
   | regex_replace('doer\\b', 'dør')
   | regex_replace('\\bEntre\\b', 'Entré')
   | regex_replace('\\bentre\\b', 'entré')
   | replace('vaerelse', 'værelse')
   | replace('Vaerelse', 'Værelse')
   | regex_replace('\\bBoern', 'Børn')
   | regex_replace('\\bboern', 'børn')
   | regex_replace('\\bKoekken', 'Køkken')
   | regex_replace('\\bkoekken', 'køkken') }}
{%- endmacro %}

{#- tal(x, dec): dansk decimal-komma, og ",0" skæres af — 6.8 → "6,8",
    10.0 → "10", 8.13 → "8,1". Ikke-tal → "?". -#}
{% macro tal(x, dec=1) -%}
{%- if x | is_number -%}
{%- set s = ('%.' ~ dec ~ 'f') | format(x | float) -%}
{%- if dec > 0 -%}{%- set s = s | regex_replace('\\.?0+$', '') -%}{%- endif -%}
{{ s | replace('.', ',') }}
{%- else -%}?{%- endif -%}
{%- endmacro %}
