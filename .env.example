# Copy this file to .env and fill in the values. .env is gitignored, so these
# values are never committed. Scripts resolve credentials in this order:
# process environment -> .env -> SUPERVISOR_TOKEN (on the HA host itself).
#
# Load into a bash session:        set -a; . ./.env; set +a
# Load into a PowerShell session:
#   Get-Content .env | foreach { if ($_ -match '^([^=#]+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] } }

# REST endpoint of the Home Assistant instance.
HA_URL=http://homeassistant.local:8123

# SSH target used by the deploy/restart helpers (HA "Advanced SSH" add-on).
HA_HOST=homeassistant.local
HA_USER=root
HA_PORT=22

# Long-lived access token for the REST API.
# HA UI: Profile (bottom left) -> Security -> Long-Lived Access Tokens -> Create Token.
HA_TOKEN=paste_your_long_lived_token_here
