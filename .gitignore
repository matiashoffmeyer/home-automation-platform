# .claude/: kun den delte settings.json (hooks) og de path-scopede regler er i
# git — worktrees m.m. er lokale
.claude/*
!.claude/settings.json
!.claude/rules/
# Agent methodology must stay visible: sub-agents, slash commands and skills
# are tracked the moment they exist (settings.local.json stays personal).
!.claude/agents/
!.claude/commands/
!.claude/skills/
.storage/
zigbee.db
zigbee.db-*
.ha_run.lock
.cache/
*.log
home-assistant.log*
home-assistant_v2.db*
secrets.yaml
secrets.yaml.*
.env
.env.local
_legacy_*
_state_safe_*
_safe_*
.plant_notify_state.json
.plant_notify_state.json.tmp
.sky_notify_state.json
.sky_notify_state.json.tmp
.mad_planner_state.json
.mad_planner_state.json.tmp
# .bak/.lock/.tmp.<pid>/.corrupt-* er sidecars til den atomiske skrivning
.mad_planner_state.json.*
__pycache__/
*.pyc

# Lokale debris / test-artefakter (ikke kildekode)
*.bak
.HA_REPO
.HA_VERSION
phase*.json
sprint_*.json

# HACS + custom integrations: self-managed (HACS opdaterer egne filer), 19MB+,
# hører ikke i config-repo'et. Installeret 2026-06-21 via custom_components/hacs.
# Vil du tracke en specifik integration: en !-undtagelse herunder (ikke
# git add -f — så ser linters og secret-scannere den heller ikke).
custom_components/*
!custom_components/volumio/
.notif_queue.lock
notif_queue.jsonl
# HA-runtime: shopping_list-integrationens punkter (mennesker skriver i den,
# scripts/mad_planner-varerne lægges ovenpå) — ren tilstand, ikke config.
.shopping_list.json
# Claude-backups af .storage-filer før en irreversibel ændring.
backups_claude/
# Nemlig-integration: session-cookies (= adgang til kontoen, chmod 600) og den
# lærte parring vare-navn -> produkt-id. Begge er runtime, ikke config.
.nemlig_session.json
.nemlig_session.json.*
.nemlig_varer.json
.nemlig_varer.json.*
# Selftest-dumpet er 222 KB ren diagnostik og kan genskabes med ét kald.
# De ØVRIGE .nemlig_*.json er derimod TRACKED med vilje (12/9): de bærer
# tilstand der ikke kan genskabes gratis — sidste_kurv er selve regnskabet
# fredningen hviler på, sensor.json er det --republish genskaber sensoren fra
# efter en restart (ellers 44 søgninger mod Nemligs API), og spoerg.json holder
# åbne parrings-spørgsmål hvis svar kan komme timer senere.
.nemlig_selftest.json
.nemlig_soegecache.json
.nemlig_soegecache.json.tmp

# Scratch: maerkede blik-frames + de to ONNX-modeller, gemt til rekalibrering
# af blik-taersklen. Ligger under /config fordi SSH-add-on'ets /tmp er et andet
# namespace end host'ens og derfor ikke kan mountes ind i en docker-test.
.tmp_face/

# mad_planner --detach-log (+ rotation)
.mad_planner_detach.log*
.claude/agent_guard_off
.claude/live_guard_off

# Genererede TTS-mp3-cacher (HA tts + højttaler-annonceringen)
tts/
www/hoejttaler_tts/

# --- Hardening (2026-10-20) ------------------------------------------------
# Credentials are never tracked, whatever they are called. The contracts that
# ARE tracked: .env.example and secrets.example.yaml.
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
ip_bans.yaml
known_devices.yaml
# HA runtime directories (Nabu Casa cloud state, pip --target installs).
.cloud/
deps/
# Python tooling caches and local virtualenvs.
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
