#!/bin/sh
# cca — hang on to Claude Code's newest tmux session (cclaude starts them), taking it from a
# connection that died. `cca <name>` for another one; `tmux ls` lists them.
s=${1:-$(tmux ls -F '#{session_activity} #{session_name}' 2>/dev/null | awk '$2 ~ /^claude-/' | sort -nr | awk '{ print $2; exit }')}
[ -n "$s" ] || { echo "Ingen Claude-session kører (start en med cclaude)."; exit 1; }
exec tmux attach -d -t "$s"
