#!/bin/sh
# cclaude — Claude Code med bypass permissions (sandbox-mode for root).
# Auto-loader OAuth token + auto-cd til /config hvis kaldt fra root cwd.
[ -f /share/claude-token.env ] && . /share/claude-token.env
if [ "$PWD" = "/" ] || [ "$PWD" = "/root" ]; then
    cd /config
fi
# In tmux (user 2026-11-26: "survive switching between wifi and mobile"): Claude keeps
# working on the NUC when the phone drops; the next login hangs on again
# (/homeassistant/scripts/claude_tmux_login.sh, `cca`). CCLAUDE_NO_TMUX=1 skips it.
if [ -z "$TMUX" ] && [ -z "$CCLAUDE_NO_TMUX" ] && [ -t 0 ] && [ -t 1 ] && command -v tmux >/dev/null 2>&1; then
    exec tmux new-session -s "claude-$(date +%d%H%M%S)" -c "$PWD" /share/node-global/bin/cclaude "$@"
fi
exec env IS_SANDBOX=1 /share/node-global/bin/claude --dangerously-skip-permissions "$@"
