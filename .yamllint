# yamllint, tuned for Home Assistant configuration.
#
# Kept: the rules that catch configuration Home Assistant would read
# differently than the author meant. Truthy is the important one: YAML 1.1 reads
# an unquoted on/off/yes/no as a boolean, so `state: on` compares a state with
# True. Booleans are written true/false and states are quoted.
#
# Off: layout rules. Most of the configuration is generated or hand-aligned,
# and the Home Assistant UI writes its own style into the files it owns.

extends: default

ignore-from-file: .gitignore

rules:
  truthy:
    level: error               # the default only warns, and warnings pass CI
    allowed-values: ["true", "false"]
    check-keys: false          # `on:` is not a key Home Assistant uses
  key-duplicates: enable       # the later key silently wins
  octal-values:
    forbid-implicit-octal: true  # 0755 would be read as 493
    forbid-explicit-octal: false
  indentation:
    spaces: consistent
    indent-sequences: whatever
    check-multi-line-strings: false

  braces: disable
  brackets: disable
  colons: disable
  commas: disable
  comments: disable
  comments-indentation: disable
  document-start: disable
  empty-lines: disable
  hyphens: disable
  line-length: disable
  new-line-at-end-of-file: disable
  trailing-spaces: disable
